{
    "name": "マルチ翻訳者",
    "description": "複数のサービスで一斉翻訳します",
    "manifest_version": 3,
    "version": "1.0.0",
    "action": {
        "default_popup": "popup.html"
    },
    "side_panel": {
        "default_path": "popup.html"
    },
    "background": {
        "service_worker": "background.js"
    },
    "permissions": ["storage", "contextMenus", "sidePanel"],
    "host_permissions": [
        "https://api-free.deepl.com/*",
        "https://api.deepl.com/*"
    ],
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}